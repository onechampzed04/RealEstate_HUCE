
# Dependencies
# These folders are installed via 'npm install' and can be very large.
node_modules/
/backend/node_modules/

# Build output
# This folder is generated by 'npm run build' for the frontend.
dist/

# Environment variables
# These files contain sensitive information like API keys or database credentials.
# NEVER commit them to version control.
.env
.env.local
.env.*.local
.env.*
backend/.env

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & System files
# These are specific to a developer's machine or operating system.
.DS_Store
.idea/
.vscode/
